# Local development: copy to .env. Matches the `db` service in compose.yaml.
DATABASE_URL=postgresql://courtly:courtly@localhost:5434/courtly
PORT=4000
# Signs the session cookie. Any random string, at least 32 characters.
JWT_SECRET=local-dev-secret-change-me-0123456789abcdef
# Set to true when the app runs behind HTTPS.
COOKIE_SECURE=false
