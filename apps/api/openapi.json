    "/api/admin/bookings": {
      "get": {
        "description": "Admin only. Bookings that start on this day in the facility time zone, turned-off courts included, earliest first, then by court name. Cancelled bookings are listed but not part of the revenue.",
        "operationId": "listDayBookings",
        "parameters": [
          {
            "name": "date",
            "required": true,
            "in": "query",
            "description": "A day in the facility time zone",
            "schema": {
              "example": "2026-11-09",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminDayDto"
                }
              }
            }
          },
          "400": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                },
                "example": {
                  "statusCode": 400,
                  "code": "VALIDATION_FAILED",
                  "message": "Some fields are not valid",
                  "details": {
                    "date": [
                      "date must be a real calendar day"
                    ]
                  }
                }
              }
            }
          },
          "401": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                },
                "example": {
                  "statusCode": 401,
                  "code": "UNAUTHENTICATED",
                  "message": "Please log in"
                }
              }
            }
          },
          "403": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                },
                "example": {
                  "statusCode": 403,
                  "code": "FORBIDDEN",
                  "message": "You are not allowed to do this"
                }
              }
            }
          }
        },
        "security": [
          {
            "cookie": []
          }
        ],
        "summary": "List all bookings of a day with the revenue",
        "tags": [
          "admin"
        ]
      }
    },
    "/api/admin/courts": {
      "get": {
        "description": "Admin only. All courts, turned-off ones included, sorted by name. To add or change a court, use POST /api/courts and PATCH /api/courts/{id}.",
        "operationId": "listAdminCourts",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AdminCourtDto"
                  }
                }
              }
            }
          },
          "401": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                },
                "example": {
                  "statusCode": 401,
                  "code": "UNAUTHENTICATED",
                  "message": "Please log in"
                }
              }
            }
          },
          "403": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                },
                "example": {
                  "statusCode": 403,
                  "code": "FORBIDDEN",
                  "message": "You are not allowed to do this"
                }
              }
            }
          }
        },
        "security": [
          {
            "cookie": []
          }
        ],
        "summary": "List courts with the number of upcoming bookings",
        "tags": [
          "admin"
        ]
      }
    }
  },
  "info": {
    "title": "Courtly API",
    "description": "Log in first with POST /api/auth/login (Try it out). It sets an httpOnly session cookie that the other calls send. The Authorize button can't set a cookie from the browser. Live updates: GET /api/events is a Server-Sent Events stream (not listed below). Each availability.changed event carries an AvailabilityChangedEventDto.",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "courtly_session"
      }
    },
    "schemas": {
      "HealthResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "ApiErrorDto": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number"
          },
          "code": {
            "type": "string",
            "description": "Stable code for the client to check"
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": "object",
            "additionalProperties": true,
            "description": "Extra data that depends on the code"
          }
        },
        "required": [
          "statusCode",
          "code",
          "message"
        ]
      },
      "FacilityDto": {
        "type": "object",
        "properties": {
          "timezone": {
            "type": "string",
            "example": "Europe/Lisbon",
            "description": "IANA time zone of the facility; show every time in it"
          },
          "bookingDaysAhead": {
            "type": "integer",
            "example": 30,
            "description": "Last bookable day is today + this"
          }
        },
        "required": [
          "timezone",
          "bookingDaysAhead"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "admin@courtly.dev"
          },
          "password": {
            "type": "string",
            "example": "courtly-demo"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "Role": {
        "type": "string",
        "enum": [
          "USER",
          "ADMIN"
        ]
      },
      "UserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "example": "admin@courtly.dev"
          },
          "name": {
            "type": "string",
            "example": "Vitalii"
          },
          "role": {
            "example": "ADMIN",
            "allOf": [
              {
                "$ref": "#/components/schemas/Role"
              }
            ]
          }
        },
        "required": [
          "id",
          "email",
          "name",
          "role"
        ]
      },
      "Sport": {
        "type": "string",
        "enum": [
          "PADEL",
          "TENNIS",
          "SQUASH",
          "PICKLEBALL",
          "BADMINTON"
        ]
      },
      "CourtDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "example": "Padel 1"
          },
          "sport": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Sport"
              }
            ]
          },
          "hourlyPriceCents": {
            "type": "integer",
            "example": 2400,
            "description": "Price per hour in cents"
          },
          "openHour": {
            "type": "integer",
            "example": 8,
            "description": "Opening hour in the facility time zone"
          },
          "closeHour": {
            "type": "integer",
            "example": 23,
            "description": "Closing hour in the facility time zone, 24 is midnight"
          },
          "isActive": {
            "type": "boolean",
            "description": "Users see only active courts"
          }
        },
        "required": [
          "id",
          "name",
          "sport",
          "hourlyPriceCents",
          "openHour",
          "closeHour",
          "isActive"
        ]
      },
      "SlotStatus": {
        "type": "string",
        "enum": [
          "AVAILABLE",
          "BOOKED",
          "PAST"
        ]
      },
      "SlotDto": {
        "type": "object",
        "properties": {
          "startsAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-11-09T10:00:00.000Z"
          },
          "endsAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-11-09T11:00:00.000Z"
          },
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/SlotStatus"
              }
            ]
          },
          "bookedByMe": {
            "type": "boolean",
            "description": "The slot is part of your own booking"
          }
        },
        "required": [
          "startsAt",
          "endsAt",
          "status",
          "bookedByMe"
        ]
      },
      "AvailabilityDto": {
        "type": "object",
        "properties": {
          "court": {
            "$ref": "#/components/schemas/CourtDto"
          },
          "date": {
            "type": "string",
            "example": "2026-11-09"
          },
          "slots": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SlotDto"
            }
          }
        },
        "required": [
          "court",
          "date",
          "slots"
        ]
      },
      "CreateCourtDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Padel 3",
            "maxLength": 60
          },
          "sport": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Sport"
              }
            ]
          },
          "hourlyPriceCents": {
            "type": "integer",
            "example": 2400,
            "minimum": 1,
            "maximum": 100000,
            "description": "Price per hour in cents"
          },
          "openHour": {
            "type": "integer",
            "example": 8,
            "minimum": 0,
            "maximum": 23
          },
          "closeHour": {
            "type": "integer",
            "example": 23,
            "minimum": 1,
            "maximum": 24,
            "description": "Must be later than openHour, 24 is midnight"
          }
        },
        "required": [
          "name",
          "sport",
          "hourlyPriceCents",
          "openHour",
          "closeHour"
        ]
      },
      "UpdateCourtDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Padel 3",
            "maxLength": 60
          },
          "sport": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Sport"
              }
            ]
          },
          "hourlyPriceCents": {
            "type": "integer",
            "example": 2400,
            "minimum": 1,
            "maximum": 100000,
            "description": "Price per hour in cents"
          },
          "openHour": {
            "type": "integer",
            "example": 8,
            "minimum": 0,
            "maximum": 23
          },
          "closeHour": {
            "type": "integer",
            "example": 23,
            "minimum": 1,
            "maximum": 24,
            "description": "Must be later than openHour, 24 is midnight"
          },
          "isActive": {
            "type": "boolean",
            "description": "false hides the court from users"
          }
        }
      },
      "CreateBookingDto": {
        "type": "object",
        "properties": {
          "courtId": {
            "type": "string",
            "format": "uuid"
          },
          "startsAt": {
            "type": "string",
            "example": "2026-11-10T10:00:00.000Z",
            "description": "startsAt of a slot from the availability endpoint"
          },
          "durationHours": {
            "type": "integer",
            "enum": [
              1,
              2
            ]
          }
        },
        "required": [
          "courtId",
          "startsAt",
          "durationHours"
        ]
      },
      "BookingCourtDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "example": "Padel 1"
          },
          "sport": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Sport"
              }
            ]
          },
          "isActive": {
            "type": "boolean",
            "description": "An inactive court keeps its bookings but takes no new ones"
          }
        },
        "required": [
          "id",
          "name",
          "sport",
          "isActive"
        ]
      },
      "BookingStatus": {
        "type": "string",
        "enum": [
          "ACTIVE",
          "CANCELLED"
        ]
      },
      "BookingDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "court": {
            "$ref": "#/components/schemas/BookingCourtDto"
          },
          "startsAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-11-10T10:00:00.000Z"
          },
          "endsAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-11-10T12:00:00.000Z"
          },
          "totalPriceCents": {
            "type": "integer",
            "example": 4800,
            "description": "Price at the time of booking"
          },
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/BookingStatus"
              }
            ]
          },
          "cancelledAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "cancellableUntil": {
            "type": "string",
            "format": "date-time",
            "description": "An active booking can be cancelled up to and including this time"
          }
        },
        "required": [
          "id",
          "court",
          "startsAt",
          "endsAt",
          "totalPriceCents",
          "status",
          "cancelledAt",
          "cancellableUntil"
        ]
      },
      "BookingScope": {
        "type": "string",
        "enum": [
          "upcoming",
          "past"
        ]
      },
      "BookingUserDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Anna Silva"
          },
          "email": {
            "type": "string",
            "example": "anna@courtly.dev"
          }
        },
        "required": [
          "name",
          "email"
        ]
      },
      "AdminBookingDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "court": {
            "$ref": "#/components/schemas/BookingCourtDto"
          },
          "startsAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-11-10T10:00:00.000Z"
          },
          "endsAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-11-10T12:00:00.000Z"
          },
          "totalPriceCents": {
            "type": "integer",
            "example": 4800,
            "description": "Price at the time of booking"
          },
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/BookingStatus"
              }
            ]
          },
          "cancelledAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "user": {
            "$ref": "#/components/schemas/BookingUserDto"
          }
        },
        "required": [
          "id",
          "court",
          "startsAt",
          "endsAt",
          "totalPriceCents",
          "status",
          "cancelledAt",
          "user"
        ]
      },
      "DayTotalsDto": {
        "type": "object",
        "properties": {
          "activeCount": {
            "type": "integer",
            "example": 4
          },
          "cancelledCount": {
            "type": "integer",
            "example": 1
          },
          "revenueCents": {
            "type": "integer",
            "example": 9600,
            "description": "Active bookings that start this day, past hours included, at their stored price"
          }
        },
        "required": [
          "activeCount",
          "cancelledCount",
          "revenueCents"
        ]
      },
      "AdminDayDto": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "example": "2026-11-09",
            "description": "A day in the facility time zone"
          },
          "bookings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AdminBookingDto"
            }
          },
          "totals": {
            "$ref": "#/components/schemas/DayTotalsDto"
          }
        },
        "required": [
          "date",
          "bookings",
          "totals"
        ]
      },
      "AdminCourtDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "example": "Padel 1"
          },
          "sport": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Sport"
              }
            ]
          },
          "hourlyPriceCents": {
            "type": "integer",
            "example": 2400,
            "description": "Price per hour in cents"
          },
          "openHour": {
            "type": "integer",
            "example": 8,
            "description": "Opening hour in the facility time zone"
          },
          "closeHour": {
            "type": "integer",
            "example": 23,
            "description": "Closing hour in the facility time zone, 24 is midnight"
          },
          "isActive": {
            "type": "boolean",
            "description": "Users see only active courts"
          },
          "upcomingBookingsCount": {
            "type": "integer",
            "example": 3,
            "description": "Active bookings that have not ended yet, in progress too. Turning the court off keeps them."
          }
        },
        "required": [
          "id",
          "name",
          "sport",
          "hourlyPriceCents",
          "openHour",
          "closeHour",
          "isActive",
          "upcomingBookingsCount"
        ]
      },
      "AvailabilityChangedEventDto": {
        "type": "object",
        "properties": {
          "courtId": {
            "type": "string",
            "format": "uuid"
          },
          "date": {
            "type": "string",
            "example": "2026-11-10",
            "description": "Facility day of the booking"
          }
        },
        "required": [
          "courtId",
          "date"
        ]
      }
    }
  }
}
