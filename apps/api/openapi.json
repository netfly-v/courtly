                      "statusCode": 422,
                      "code": "COURT_INACTIVE",
                      "message": "This court is not taking new bookings"
                    }
                  },
                  "SLOT_NOT_ALIGNED": {
                    "summary": "SLOT_NOT_ALIGNED",
                    "value": {
                      "statusCode": 422,
                      "code": "SLOT_NOT_ALIGNED",
                      "message": "Bookings start on the hour"
