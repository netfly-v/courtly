    "/api/courts/{id}/availability": {
      "get": {
        "description": "One-hour slots from opening to closing on a day in the facility time zone. Each slot is AVAILABLE, BOOKED or PAST, and bookedByMe marks your own bookings. A day after today + bookingDaysAhead (GET /api/facility) answers 422.",
