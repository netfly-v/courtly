generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  // Docker runs generate before tsconfig.json is copied; without this Prisma emits .ts imports.
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// Not expressible here, added as raw SQL in the migration:
// the booking overlap EXCLUDE constraint and the CHECK constraints.

enum Role {
  USER
  ADMIN

  @@map("role")
}

enum Sport {
  PADEL
  TENNIS
  SQUASH
  PICKLEBALL
  BADMINTON

  @@map("sport")
}

enum BookingStatus {
  ACTIVE
  CANCELLED

  @@map("booking_status")
}

model User {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String    @unique
  name         String
  passwordHash String    @map("password_hash")
  role         Role      @default(USER)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  bookings     Booking[]

  @@map("users")
}

model Court {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  sport            Sport
  hourlyPriceCents Int       @map("hourly_price_cents")
  openHour         Int       @map("open_hour") @db.SmallInt
  closeHour        Int       @map("close_hour") @db.SmallInt
  isActive         Boolean   @default(true) @map("is_active")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  bookings         Booking[]

  @@map("courts")
}

model Booking {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String        @map("user_id") @db.Uuid
  courtId         String        @map("court_id") @db.Uuid
  startsAt        DateTime      @map("starts_at") @db.Timestamptz(3)
  endsAt          DateTime      @map("ends_at") @db.Timestamptz(3)
  totalPriceCents Int           @map("total_price_cents")
  status          BookingStatus @default(ACTIVE)
  cancelledAt     DateTime?     @map("cancelled_at") @db.Timestamptz(3)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  user            User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  court           Court         @relation(fields: [courtId], references: [id], onDelete: Restrict)

  @@index([courtId, startsAt])
  @@index([startsAt])
  @@index([userId, startsAt])
  @@map("bookings")
}
